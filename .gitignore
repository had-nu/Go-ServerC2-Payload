# Go-ServerC2-Payload
#
# Build output
bin/
*.exe
*.exe~
*.so
*.dylib
*.test
*.out

# The working Beacon. The published repository has the interface stub in
# cmd/beacon. A lab operator builds the working Beacon from lab/.
lab/

# Local state: the shared secret and the TLS certificate
*.key
*.crt

# Environment
.env

# Editor and OS files
.vscode/
.idea/
.DS_Store

# A "go build ./lab/..." leaves the binary in the working directory.
# Ignore the built Beacon name at the root as well.
/beacon
/beacon-impl
/team-server
